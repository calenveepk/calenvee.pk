# Calenvee Store Configuration & Shopify Storefront API Integration
# When you're ready to connect your Shopify store, paste your domain and Storefront Access Token here.
# Set VITE_USE_SHOPIFY_API to true to fetch live products from your Shopify GraphQL endpoint!

VITE_SHOPIFY_STORE_DOMAIN=your-shopify-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_access_token_here
VITE_SHOPIFY_API_VERSION=2024-01
VITE_USE_SHOPIFY_API=false

# Store Details
VITE_STORE_NAME=Calenvee
VITE_STORE_EMAIL=Calenvee.Pk@gmail.com
VITE_STORE_INSTAGRAM=@Calenvee.Pk
VITE_STORE_FACEBOOK=Calenvee.Pk

