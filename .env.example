# =====================================================================
# CALENVEE.PK — PRODUCTION ENVIRONMENT VARIABLES (OPTION B)
# Vercel Serverless + Supabase PostgreSQL + Resend Email API ($0/mo)
# =====================================================================

# 1. SUPABASE POSTGRESQL (Free Tier Database & Storage)
# Get these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. RESEND TRANSACTIONAL EMAIL API (3,000 Free Emails / Month)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
RESEND_FROM_EMAIL=orders@calenvee.pk
STORE_ALERT_EMAIL=orders@calenvee.pk

# 3. GOOGLE APPS SCRIPT WEBHOOK (Optional Background Mirroring)
# Kept alive for seamless zero-downtime transition to Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbwCZvq-OqA4l18DK3ecPrRSclzRrNz2dINOiMY-qaNeyfjLvB-mSbJQH4cO_gWMWcBm/exec"
VITE_GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbwCZvq-OqA4l18DK3ecPrRSclzRrNz2dINOiMY-qaNeyfjLvB-mSbJQH4cO_gWMWcBm/exec"

# 4. OPTIONAL SHOPIFY STOREFRONT API (If connecting to Shopify catalog)
VITE_SHOPIFY_STORE_DOMAIN=your-shopify-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_access_token_here
VITE_SHOPIFY_API_VERSION=2024-01
VITE_USE_SHOPIFY_API=false
